{
  "openapi": "3.0.0",
  "info": {
    "title": "省思袋冲动消费审批API",
    "description": "省思袋全网审批流同步、消费数据查询与AI劝退决策插件",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://sengsidai.netlify.app"
    }
  ],
  "paths": {
    "/api/sync-data": {
      "get": {
        "operationId": "getAllApprovalsAndGoodItems",
        "summary": "获取全网最新的消费审批单与好物列表",
        "description": "拉取省思袋全网当前正在冷静期的单子、已结算胜负战绩以及精选好物库",
        "responses": {
          "200": {
            "description": "成功返回全网数据"
          }
        }
      },
      "post": {
        "operationId": "createApprovalOrVote",
        "summary": "向全网广播发起一笔新审批或提交表态投票",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "create_approval",
                      "submit_vote"
                    ]
                  },
                  "payload": {
                    "type": "object"
                  }
                },
                "required": [
                  "type",
                  "payload"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "提交成功"
          }
        }
      }
    }
  }
}